# ═══════════════════════════════════════════════════════════════════════════════
# FamilyApp — Configuration NAS (Zorin OS / installation native)
#
# 1. Copiez ce fichier : cp .env.nas.example .env
# 2. Remplissez les valeurs marquées CHANGE_ME
# 3. Lancez : sudo scripts/install-nas.sh
# ═══════════════════════════════════════════════════════════════════════════════

# ── Serveur ───────────────────────────────────────────────────────────────────
NODE_ENV=production

# Port d'écoute du backend Express.
# L'app Electron et tous les appareils de la famille y accèdent.
PORT=5000

# ── Base de données ───────────────────────────────────────────────────────────
# Le script install-nas.sh crée automatiquement cet utilisateur et cette base.
# Changez le mot de passe avant de lancer l'installation.
DATABASE_URL=postgresql://familyapp:CHANGE_ME_DB_PASS@localhost:5432/familyapp

# ── Secrets JWT ───────────────────────────────────────────────────────────────
# Générez des valeurs aléatoires (≥ 32 caractères) :
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL d'accès à l'application depuis les autres appareils de la famille.
# Utilisez l'IP locale du NAS ou un nom d'hôte si vous avez un DNS local.
# Exemples : http://192.168.1.50:5000  |  http://nas.local:5000
CLIENT_URL=http://localhost:5000

# Chemin vers le build React servi par Express en production.
# Laissez vide : le serveur le détecte automatiquement depuis server/dist/.
# Utile uniquement si votre layout de dossiers est non standard.
CLIENT_DIST_PATH=

# ── Uploads ───────────────────────────────────────────────────────────────────
# Dossier de stockage des fichiers uploadés (photos, pièces jointes…).
# Pointez vers un volume persistant de votre NAS pour ne pas perdre les fichiers
# lors d'une mise à jour. Ex : /mnt/data/familyapp/uploads
# Laissez vide pour utiliser le dossier par défaut (./uploads dans l'install dir).
UPLOADS_DIR=

# ── Sauvegardes ───────────────────────────────────────────────────────────────
# Dossier de destination des archives de sauvegarde (pg_dump + uploads).
# Pour une vraie résilience, pointez vers un volume séparé du NAS.
# Ex : /mnt/nas-backup/familyapp  |  /media/usb-backup/familyapp
# Laissez vide pour utiliser le dossier par défaut (./backups dans l'install dir).
BACKUP_DIR=

# Nombre de jours de rétention des sauvegardes (défaut : 7).
# Les archives plus anciennes sont supprimées automatiquement après chaque sauvegarde.
BACKUP_RETENTION_DAYS=7

# ── Email (optionnel) ─────────────────────────────────────────────────────────
# Nécessaire pour la réinitialisation de mot de passe par email.
# Fournisseurs recommandés : Brevo (gratuit 300/jour), Resend, Gmail App Password.
# Laissez vide pour désactiver — le lien de reset sera loggé côté serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Cloudinary (optionnel) ────────────────────────────────────────────────────
# Stockage cloud des médias. Laissez vide pour utiliser le stockage local.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Calendar (optionnel) ───────────────────────────────────────────────
# Laissez vide pour désactiver la synchronisation Google Agenda.
#
# Configuration (5 minutes) :
#   1. https://console.cloud.google.com → New Project → "FamilyApp"
#   2. APIs & Services → Enable "Google Calendar API"
#   3. Credentials → OAuth 2.0 Client → Web application
#      Authorized redirect URI : http://<IP_NAS>:5000/api/v1/google/callback
#   4. Copiez Client ID et Client Secret ci-dessous
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redirection OAuth — doit correspondre exactement à ce qui est configuré
# dans la Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/google/callback

# ── LM Studio (chatbot IA local, optionnel) ───────────────────────────────────
# LM Studio doit tourner sur le même NAS que le serveur FamilyApp.
# Téléchargez LM Studio : https://lmstudio.ai
#   1. Installez LM Studio → chargez un modèle (ex. Llama 3.2, Mistral, Phi-4)
#   2. Démarrez le serveur local (menu "Local Server" → Start)
#   3. L'API sera accessible à http://localhost:1234
#
# Laissez LM_STUDIO_URL vide pour désactiver le chatbot.
LM_STUDIO_URL=http://localhost:1234
# Identifiant du modèle tel qu'affiché dans LM Studio (ex. "lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF").
# Laissez vide pour utiliser le modèle actuellement chargé.
LM_STUDIO_MODEL=
