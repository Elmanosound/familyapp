# ── Client build-time configuration ─────────────────────────────────────────
# Copy to ".env" (web build) or ".env.production" and fill in.
#
# WEB build (served by the backend behind Caddy): leave these EMPTY — the client
# uses relative "/api/v1" and the same origin for sockets.
#
# ANDROID / mobile build (Capacitor): these MUST be set to an ABSOLUTE URL the
# phone can reach, because the WebView origin is https://localhost.
#
#   - LAN testing (server on your PC/NAS):  http://192.168.1.20:5000/api/v1
#     (also requires cleartext HTTP — see docs/ANDROID.md)
#   - Production (deployed server):          https://family.example.com/api/v1

# Base URL of the REST API (must include the /api/v1 suffix).
VITE_API_URL=

# Socket.io server origin (host root, NO /api/v1). If empty on native, it is
# derived from VITE_API_URL's origin automatically.
VITE_SOCKET_URL=
