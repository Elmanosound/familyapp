[Unit]
Description=FamilyApp — Backend Service
Documentation=https://github.com/Elmanosound/familyapp
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=FAMILYAPP_USER
Group=FAMILYAPP_USER
WorkingDirectory=INSTALL_DIR

# Load environment variables from the .env file
EnvironmentFile=INSTALL_DIR/.env

# Run the compiled Express server
ExecStart=/usr/bin/node server/dist/index.js

# Restart the service 5 s after an unexpected crash, up to 5 times per minute.
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

# Forward stdout/stderr to the systemd journal (queryable with journalctl -u familyapp)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=familyapp

# Hardening: prevent the service from acquiring new privileges
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
