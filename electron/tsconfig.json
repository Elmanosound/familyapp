{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "CommonJS",
    "moduleResolution":  "node",
    "outDir":            "./dist",
    "rootDir":           ".",
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "sourceMap":         false
  },
  "include": ["main.ts", "preload.ts"],
  "exclude": ["dist", "node_modules"]
}
